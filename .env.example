# ─────────────────────────────────────────────────────────────────────────────
#  SalonSync — .env.example. Copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you. Every key is
#  OPTIONAL — with none set, SalonSync runs in DEMO MODE with a sample week of
#  appointments, clients and payments.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe — deposits, no-show fees and payments ─────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# ── Twilio — SMS appointment reminders & confirmations ───────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Supabase — stores clients, appointments and services (optional) ──────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
